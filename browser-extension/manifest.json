{
  "manifest_version": 3,
  "name": "Waps",
  "version": "1.0",
  "description": "Save bookmarks to your Waps account",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.convex.cloud/*", "https://*.convex.site/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
