# Convex (required)
# Find these in your Convex dashboard -> Deployments -> Environment Variables
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site

# Shared secret used only by trusted Next.js auth routes when calling
# protected manual-auth mutations in Convex. Set the same random value in
# the Next.js and Convex environments; never expose it as NEXT_PUBLIC_*.
MANUAL_AUTH_INTERNAL_SECRET=replace-with-a-long-random-secret

# Only set this when the deployment terminates requests at a proxy that
# overwrites the header (e.g. x-vercel-forwarded-for). Enables the per-IP
# sign-in rate limiter. Leave unset elsewhere: client-supplied headers are
# spoofable.
# TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Canonical public URL of this app - used for sitemap.xml / robots.txt.
# Falls back to https://waps.app when unset.
NEXT_PUBLIC_SITE_URL=https://waps.app

# Email (Resend) - optional, required for password reset emails.
# Get a key at https://resend.com
RESEND_API_KEY=re_xxxxx

# Where contact form submissions should be sent
CONTACT_TO=you@example.com

# Sender email domain must be verified in Resend
CONTACT_FROM=Waps <noreply@your-domain.com>

# Screenshot provider (optional). When SCREENSHOT_ALLOWED_ORIGINS is set,
# both the provider URL and the returned image URL must match one of the
# comma-separated origins.
# SCREENSHOT_API_URL=https://example.com/screenshot
# SCREENSHOT_API_KEY=
# SCREENSHOT_ALLOWED_ORIGINS=https://example.com

# Optional Ollama endpoint for AI tag/description suggestions.
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
